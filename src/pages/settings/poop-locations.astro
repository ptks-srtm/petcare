---
import AppHeader from '../../components/AppHeader.astro';
import PageHeader from '../../components/PageHeader.astro';
import { PoopLocationSettings } from '../../components/PoopLocationSettings';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="うんちをした場所の設定 | PetCare" description="うんちログで使用する場所の選択肢を管理します。">
	<AppHeader />
	<main class="mx-auto max-w-xl px-4 py-6 sm:px-5 sm:py-8">
		<PageHeader backHref="/settings" backLabel="設定へ戻る" title="うんちをした場所の設定" description="うんちログで使用する場所を追加・編集できます。" />
		<PoopLocationSettings client:load />
	</main>
</Layout>
