---
import Layout from '../layouts/Layout.astro';
import { PoopLogApp } from '../components/PoopLogApp';
import AppHeader from '../components/AppHeader.astro';
import { PetProfilePanel } from '../components/PetProfilePanel';
import { TodayHero } from '../components/TodayHero';
import { StorageStatusNotice } from '../components/StorageStatusNotice';
---

<Layout title="PetCare | ペットの毎日を記録しよう" description="PetCareは犬・猫の健康記録をサポートするシンプルなペットヘルスケアアプリです。">
	<AppHeader />

	<main class="mx-auto max-w-xl px-4 py-6 sm:px-5 sm:py-8">
		<StorageStatusNotice showSettingsLink className="mb-5" client:load />
		<TodayHero client:load />
		<PetProfilePanel variant="home" client:load />
		<div id="new-log-title" class="scroll-mt-4">
			<PoopLogApp client:load />
		</div>
	</main>
</Layout>
