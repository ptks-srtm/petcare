---
import AppHeader from '../components/AppHeader.astro';
import { ConsultationApp } from '../components/consultation/ConsultationApp';
import Layout from '../layouts/Layout.astro';
---

<Layout title="記録を振り返る | PetCare" description="記録を分析したり、気になることを整理できます。">
	<AppHeader compact />
	<main class="mx-auto max-w-xl px-4 py-6 sm:px-5 sm:py-8">
		<div class="mb-5">
			<a href="/" class="inline-flex min-h-11 items-center text-sm font-semibold text-brand-blue focus-visible:rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-sky">← ホームへ戻る</a>
			<h1 class="mt-2 text-2xl font-semibold tracking-tight text-slate-800">記録を振り返る</h1>
			<p class="mt-1 text-sm leading-relaxed text-slate-500">記録を分析したり、気になることを整理できます。</p>
		</div>
		<div id="record-analysis" class="scroll-mt-4">
			<ConsultationApp client:load />
		</div>
	</main>
</Layout>
