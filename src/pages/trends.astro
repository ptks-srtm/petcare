---
import AppHeader from '../components/AppHeader.astro';
import PageHeader from '../components/PageHeader.astro';
import { TrendsApp } from '../components/TrendsApp';
import Layout from '../layouts/Layout.astro';
---

<Layout title="傾向 | PetCare" description="うんち・ごはん・さんぽの直近7日間の傾向を確認できます。">
	<AppHeader />
	<main class="mx-auto max-w-xl px-4 py-6 sm:px-5 sm:py-8">
		<PageHeader backHref="/" backLabel="ホームへ戻る" title="傾向" description="直近7日間の記録を日ごとに振り返れます" />
		<TrendsApp client:load />
	</main>
</Layout>
