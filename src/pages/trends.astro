---
import AppHeader from '../components/AppHeader.astro';
import PageHeader from '../components/PageHeader.astro';
import { TrendsApp } from '../components/TrendsApp';
import Layout from '../layouts/Layout.astro';
---

<Layout title="傾向 | PetCare" description="体重、さんぽ、ごはん、うんち、病院の記録を7日・30日・90日で振り返れます。">
	<AppHeader />
	<main class="mx-auto max-w-xl px-4 py-6 sm:px-5 sm:py-8">
		<PageHeader backHref="/" backLabel="ホームへ戻る" title="傾向" description="最近の記録を期間ごとに振り返れます" />
		<TrendsApp client:load />
	</main>
</Layout>
