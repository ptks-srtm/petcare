---
import { ChevronLeft } from 'lucide-react';

type Props = {
	backHref: string;
	backLabel: string;
	title: string;
	description?: string;
};

const { backHref, backLabel, title, description } = Astro.props;
---

<div class="mb-6 px-1">
	<a href={backHref} class="mb-4 inline-flex min-h-10 items-center gap-1 rounded-xl pr-3 text-sm font-semibold text-slate-500 transition hover:bg-white hover:text-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-sky">
		<ChevronLeft size={18} aria-hidden="true" />
		{backLabel}
	</a>
	<h1 class="text-2xl font-semibold tracking-tight text-slate-800">{title}</h1>
	{description && <p class="mt-1.5 text-sm leading-relaxed text-slate-500">{description}</p>}
</div>
