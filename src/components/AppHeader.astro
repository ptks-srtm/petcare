---
import { Cat, Dog, Settings } from 'lucide-react';
---

<header class="border-b border-border-soft bg-white/95 backdrop-blur">
	<div class="mx-auto flex max-w-xl items-center justify-between gap-3 px-5 py-4">
		<a href="/" class="flex items-center gap-3 rounded-2xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-sky" aria-label="PetCare ホーム">
			<span class="flex size-11 shrink-0 items-center justify-center gap-0.5 rounded-2xl bg-brand-subtle text-brand-primary ring-1 ring-border-soft" aria-hidden="true">
				<Dog size={19} strokeWidth={1.8} />
				<Cat size={17} strokeWidth={1.8} />
			</span>
			<span>
				<span class="block text-lg font-semibold tracking-tight text-slate-800">PetCare</span>
				<span class="block text-xs font-normal text-slate-500">ペットの毎日を記録しよう</span>
			</span>
		</a>
		<a href="/settings" aria-label="設定を開く" class="grid size-11 shrink-0 place-items-center rounded-xl text-slate-400 transition hover:bg-slate-100 hover:text-slate-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-sky">
			<Settings size={20} aria-hidden="true" />
		</a>
	</div>
</header>
